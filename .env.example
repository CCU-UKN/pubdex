# PubDex / PeopleDB environment template — copy to DB/.env and fill in values;
# DB/.env must never be committed:
#
#     cp .env.example DB/.env
#
# Everything reads DB/.env: docker compose picks it up automatically when run
# from DB/, and people_pubs/config.py fills connection gaps from it (unless
# PEOPLE_PUBS_SKIP_DOTENV=1, which the check suites set for their tests).

# --- Docker / network -------------------------------------------------------
# Private interface IP the containers publish on.
# compose refuses to start when this is unset (:? guard) because an empty
# value would otherwise publish Postgres/pgAdmin on ALL interfaces.
# Use a second loopback address such as 127.0.0.2 for a local-only setup.
WG_BIND_IP=127.0.0.2

# --- PostgreSQL superuser + libpq defaults ----------------------------------
POSTGRES_PASSWORD=change-me-postgres
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=people_db
PGPASSWORD=change-me-postgres
# Full DSN override for the ingestion package; when unset, the connection is
# assembled from the PG* keys above.
# PEOPLE_DB_DSN=postgresql://postgres:<password>@127.0.0.1:5432/people_db

# --- Application roles (sync_db_role_passwords.sh --apply syncs them) -------
APP_READONLY_PASSWORD=change-me-readonly
APP_WRITER_PASSWORD=change-me-writer
# Optional maintenance role used by restore/admin tooling.
MAINTENANCE_PASSWORD=

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.org
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
# Local browser port for pgAdmin (default 8081).
PGADMIN_LOCAL_PORT=8081

# --- Polite-pool contact (User-Agent / mailto) ------------------------------
PEOPLE_PUBS_CROSSREF_MAILTO=you@example.org

# --- Employment matching (which employers count as "ours") ------------------
# Semicolon- or comma-separated organisation names and abbreviations. ORCID
# profile enrichment records an employment only when one of these patterns
# matches the employer name (accent-folded, case-insensitive, token-based).
#
# EMPTY BY DEFAULT, and empty means NO employment matches — not all of them.
# Leave it empty until you know which employers you want recorded.
#
#   PEOPLE_PUBS_ORG_PATTERNS=Example University;Institute for Example Studies;exinst
#
# This is NOT the same setting as institutional publication attribution, which
# decides which publications reach the canonical list and lives in the database
# table app.institution_attribution_rules (see DB/SCRIPTS.md, "Institutional
# attribution"). Configuring one does not configure the other.
PEOPLE_PUBS_ORG_PATTERNS=

# --- External API credentials (leave empty to disable that source) ----------
SEMANTIC_SCHOLAR_API_KEY=
DATACITE_API_TOKEN=
